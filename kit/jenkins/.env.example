# ==============================================================================
# Variables de Entorno para Jenkins Controller + Smee.io Relay
# ==============================================================================

# Puerto HTTP del Host para Jenkins (UI y Webhooks)
JENKINS_PORT=8080

# Puerto para agentes inbound remotos JNLP
JENKINS_AGENT_PORT=50000

# GID numérico del grupo docker del Host para permisos de /var/run/docker.sock
# En Linux ejecute: getent group docker | cut -d: -f3
# En Docker Desktop / WSL2 usualmente es 998 o 115
DOCKER_GID=998

# Canal público de Smee.io generado en https://smee.io
# Reemplace con su URL obtenida al presionar 'Start a new channel'
SMEE_URL=https://smee.io/REEMPLAZAR_CON_TU_CANAL

# Destino interno del webhook hacia el contenedor de Jenkins (con doble barra final para que smee-client no la remueva)
SMEE_TARGET=http://jenkins:8080/github-webhook//
